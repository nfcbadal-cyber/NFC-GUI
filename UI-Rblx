-- Dragging System (FIXED)
function UILibrary:SetupDragging(window, topBar)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = window.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            window.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- Minimize/Maximize System (FIXED)
function UILibrary:SetupMinimizeMaximize()
    -- Main minimize
    self.MinimizeBtn.MouseButton1Click:Connect(function()
        self:Minimize()
    end)
    
    -- Main maximize
    self.MaximizeBtn.MouseButton1Click:Connect(function()
        self:Maximize()
    end)
    
    -- Mini minimize
    self.MiniMinBtn.MouseButton1Click:Connect(function()
        self:Minimize()
    end)
    
    -- Mini maximize
    self.MiniMaxBtn.MouseButton1Click:Connect(function()
        self:Maximize()
    end)
end

function UILibrary:Minimize()
    if self.Minimized then return end
    self.Minimized = true
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Hide content
    local contentTween = TweenService:Create(self.Content, tweenInfo, {
        Size = UDim2.new(1, 0, 0, 0)
    })
    contentTween:Play()
    
    -- Shrink window
    local windowTween = TweenService:Create(self.Window, tweenInfo, {
        Size = UDim2.new(0, 200, 0, 35)
    })
    windowTween:Play()
    
    -- Show mini UI
    self.MiniUI.Visible = true
    
    -- Update button text
    self.MinimizeBtn.Text = "☐"
    self.MiniMinBtn.Text = "☐"
end

function UILibrary:Maximize()
    if not self.Minimized then return end
    self.Minimized = false
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Show content
    local contentTween = TweenService:Create(self.Content, tweenInfo, {
        Size = UDim2.new(1, 0, 1, -35)
    })
    contentTween:Play()
    
    -- Expand window
    local windowTween = TweenService:Create(self.Window, tweenInfo, {
        Size = UDim2.new(0, 500, 0, 400)
    })
    windowTween:Play()
    
    -- Hide mini UI
    self.MiniUI.Visible = false
    
    -- Update button text
    self.MinimizeBtn.Text = "─"
    self.MiniMinBtn.Text = "─"
end

-- Icon Button System (FIXED)
function UILibrary:SetupIconButton(iconBtn, window)
    local isVisible = true
    
    -- Hover Effects
    local hoverTween = nil
    iconBtn.MouseEnter:Connect(function()
        if hoverTween then hoverTween:Cancel() end
        hoverTween = TweenService:Create(iconBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 60, 0, 60),
            Position = UDim2.new(0, 12.5, 0.5, -30)
        })
        hoverTween:Play()
        
        -- Show glow
        self.IconGlow.Visible = true
        TweenService:Create(self.IconGlow, TweenInfo.new(0.3), {
            ImageTransparency = 0.5
        }):Play()
    end)
    
    iconBtn.MouseLeave:Connect(function()
        if hoverTween then hoverTween:Cancel() end
        hoverTween = TweenService:Create(iconBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 55, 0, 55),
            Position = UDim2.new(0, 15, 0.5, -27.5)
        })
        hoverTween:Play()
        
        -- Hide glow
        TweenService:Create(self.IconGlow, TweenInfo.new(0.3), {
            ImageTransparency = 0.8
        }):Play()
        wait(0.3)
        self.IconGlow.Visible = false
    end)
    
    -- Left Click: Toggle Visibility
    iconBtn.MouseButton1Click:Connect(function()
        if self.Minimized then
            self:Maximize()
            return
        end
        
        isVisible = not isVisible
        self.IsVisible = isVisible
        
        if isVisible then
            window.Visible = true
            TweenService:Create(window, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -250, 0.5, -200)
            }):Play()
            iconBtn.BackgroundColor3 = UI_THEME.Accent
        else
            TweenService:Create(window, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, -250, 0.5, -250)
            }):Play()
            wait(0.3)
            window.Visible = false
            iconBtn.BackgroundColor3 = UI_THEME.IconBg
        end
    end)
    
    -- Right Click: Minimize/Restore
    iconBtn.MouseButton2Click:Connect(function()
        if self.Minimized then
            self:Maximize()
        else
            self:Minimize()
        end
    end)
    
    -- Keyboard Shortcut: Ctrl + M
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.M and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            if self.Minimized then
                self:Maximize()
            else
                self:Minimize()
            end
        end
    end)
end

-- Create Tab (FIXED)
function UILibrary:CreateTab(tabName, icon)
    if not self.TabsContainer then
        error("UI Library not initialized! Call CreateWindow first.")
        return
    end
    
    local tabData = {
        Name = tabName,
        Icon = icon or "📄",
        Elements = {}
    }
    
    -- Create tab button
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_" .. tabName
    tabBtn.Size = UDim2.new(1, -10, 0, 35)
    tabBtn.Position = UDim2.new(0, 5, 0, #self.Tabs * 40 + 5)
    tabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = "  " .. tabData.Icon .. " " .. tabName
    tabBtn.TextColor3 = UI_THEME.TextDim
    tabBtn.TextSize = 13
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Font = Enum.Font.Gotham
    tabBtn.Parent = self.TabsContainer
    
    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 4)
    tabCorner.Parent = tabBtn
    
    -- Update canvas size
    self.TabsContainer.CanvasSize = UDim2.new(0, 0, 0, (#self.Tabs + 1) * 40 + 10)
    
    -- Tab content frame
    local tabContent = Instance.new("Frame")
    tabContent.Name = "TabContent_" .. tabName
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = self.ContentArea
    
    tabData.Button = tabBtn
    tabData.Content = tabContent
    
    -- Store tab
    table.insert(self.Tabs, tabData)
    
    -- Button click to switch tab
    tabBtn.MouseButton1Click:Connect(function()
        self:SelectTab(tabData)
    end)
    
    -- If first tab, select it
    if #self.Tabs == 1 then
        self:SelectTab(tabData)
    end
    
    return {
        Tab = tabData,
        AddToggle = function(_, label, default, callback)
            return UILibrary:AddToggle(tabData, label, default, callback)
        end,
        AddSlider = function(_, label, min, max, default, callback)
            return UILibrary:AddSlider(tabData, label, min, max, default, callback)
        end,
        AddDropdown = function(_, label, options, default, callback)
            return UILibrary:AddDropdown(tabData, label, options, default, callback)
        end,
        AddTextBox = function(_, label, default, callback)
            return UILibrary:AddTextBox(tabData, label, default, callback)
        end
    }
end

-- Select Tab (FIXED)
function UILibrary:SelectTab(tabData)
    if self.CurrentTab then
        self.CurrentTab.Content.Visible = false
        self.CurrentTab.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        self.CurrentTab.Button.TextColor3 = UI_THEME.TextDim
    end
    
    self.CurrentTab = tabData
    tabData.Content.Visible = true
    tabData.Button.BackgroundColor3 = UI_THEME.Accent
    tabData.Button.TextColor3 = UI_THEME.Text
end

-- Add Toggle (FIXED)
function UILibrary:AddToggle(tabData, label, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 45 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.7, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = UI_THEME.Text
    labelText.TextSize = 14
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local toggleBtn = Instance.new("Frame")
    toggleBtn.Size = UDim2.new(0, 50, 0, 25)
    toggleBtn.Position = UDim2.new(1, -55, 0.5, -12.5)
    toggleBtn.BackgroundColor3 = default and UI_THEME.ToggleOn or UI_THEME.ToggleOff
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Parent = frame
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleBtn
    
    local toggleDot = Instance.new("Frame")
    toggleDot.Size = UDim2.new(0, 21, 0, 21)
    toggleDot.Position = default and UDim2.new(1, -26, 0.5, -10.5) or UDim2.new(0, 4, 0.5, -10.5)
    toggleDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleDot.BorderSizePixel = 0
    toggleDot.Parent = toggleBtn
    
    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = toggleDot
    
    local state = default or false
    
    local function updateToggle()
        toggleBtn.BackgroundColor3 = state and UI_THEME.ToggleOn or UI_THEME.ToggleOff
        toggleDot.Position = state and UDim2.new(1, -26, 0.5, -10.5) or UDim2.new(0, 4, 0.5, -10.5)
        if callback then callback(state) end
    end
    
    local clickDetector = Instance.new("ImageButton")
    clickDetector.Size = UDim2.new(1, 0, 1, 0)
    clickDetector.BackgroundTransparency = 1
    clickDetector.Parent = toggleBtn
    
    clickDetector.MouseButton1Click:Connect(function()
        state = not state
        updateToggle()
    end)
    
    updateToggle()
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetValue = function(_, value)
            state = value
            updateToggle()
        end,
        GetValue = function()
            return state
        end
    }
end

