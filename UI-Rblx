-- ===== ADD COLOR PICKER =====
function UILibrary:AddColorPicker(tabData, label, default, callback)
    local currentTheme = UI_THEMES[Settings.Theme]
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 45)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 50 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.7, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = currentTheme.Text
    labelText.TextSize = 15
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local colorBtn = Instance.new("ImageButton")
    colorBtn.Size = UDim2.new(0, 30, 0, 30)
    colorBtn.Position = UDim2.new(1, -35, 0.5, -15)
    colorBtn.BackgroundColor3 = default or currentTheme.Accent
    colorBtn.BorderSizePixel = 2
    colorBtn.BorderColor3 = currentTheme.Border
    colorBtn.Parent = frame
    
    local colorCorner = Instance.new("UICorner")
    colorCorner.CornerRadius = UDim.new(1, 0)
    colorCorner.Parent = colorBtn
    
    local selectedColor = default or currentTheme.Accent
    
    colorBtn.MouseButton1Click:Connect(function()
        -- Simple color cycle for demo
        local colors = {
            Color3.fromRGB(255, 0, 0),
            Color3.fromRGB(0, 255, 0),
            Color3.fromRGB(0, 0, 255),
            Color3.fromRGB(255, 255, 0),
            Color3.fromRGB(255, 0, 255),
            Color3.fromRGB(0, 255, 255),
            Color3.fromRGB(255, 128, 0),
            Color3.fromRGB(128, 0, 255),
        }
        
        local currentIndex = 1
        for i, color in ipairs(colors) do
            if color == selectedColor then
                currentIndex = i
                break
            end
        end
        
        currentIndex = currentIndex % #colors + 1
        selectedColor = colors[currentIndex]
        colorBtn.BackgroundColor3 = selectedColor
        if callback then callback(selectedColor) end
    end)
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetValue = function(_, value)
            selectedColor = value
            colorBtn.BackgroundColor3 = value
            if callback then callback(value) end
        end,
        GetValue = function()
            return selectedColor
        end
    }
end

-- ===== ADD BUTTON =====
function UILibrary:AddButton(tabData, label, callback)
    local currentTheme = UI_THEMES[Settings.Theme]
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 45)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 50 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundColor3 = currentTheme.Accent
    button.BorderSizePixel = 0
    button.Text = label
    button.TextColor3 = currentTheme.Text
    button.TextSize = 16
    button.Font = Enum.Font.GothamBold
    button.Parent = frame
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, Settings.CornerRadius - 2)
    buttonCorner.Parent = button
    
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {
            BackgroundColor3 = currentTheme.AccentHover
        }):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {
            BackgroundColor3 = currentTheme.Accent
        }):Play()
    end)
    
    button.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetText = function(_, text)
            button.Text = text
        end
    }
end

-- ===== ADD LABEL =====
function UILibrary:AddLabel(tabData, label, text)
    local currentTheme = UI_THEMES[Settings.Theme]
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 40 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.3, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = currentTheme.Text
    labelText.TextSize = 14
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local valueText = Instance.new("TextLabel")
    valueText.Size = UDim2.new(0.6, 0, 1, 0)
    valueText.Position = UDim2.new(0.35, 0, 0, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = text or ""
    valueText.TextColor3 = currentTheme.Accent
    valueText.TextSize = 14
    valueText.TextXAlignment = Enum.TextXAlignment.Right
    valueText.Font = Enum.Font.Gotham
    valueText.Parent = frame
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetText = function(_, newText)
            valueText.Text = newText
        end
    }
end

