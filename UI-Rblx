function UILibrary:AddDropdown(tabData, label, options, default, callback)
    local currentTheme = UI_THEMES[Settings.Theme]
    
    if not options or #options == 0 then
        error("Dropdown must have at least one option")
        return
    end
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 45)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 50 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.4, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = currentTheme.Text
    labelText.TextSize = 15
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local dropdownBtn = Instance.new("TextButton")
    dropdownBtn.Size = UDim2.new(0.55, 0, 1, 0)
    dropdownBtn.Position = UDim2.new(0.4, 5, 0, 0)
    dropdownBtn.BackgroundColor3 = currentTheme.Dropdown
    dropdownBtn.BorderSizePixel = 1
    dropdownBtn.BorderColor3 = currentTheme.Border
    dropdownBtn.Text = default or options[1]
    dropdownBtn.TextColor3 = currentTheme.Text
    dropdownBtn.TextSize = 14
    dropdownBtn.Font = Enum.Font.Gotham
    dropdownBtn.Parent = frame
    
    local dropdownCorner = Instance.new("UICorner")
    dropdownCorner.CornerRadius = UDim.new(0, Settings.CornerRadius - 2)
    dropdownCorner.Parent = dropdownBtn
    
    local dropdownList = Instance.new("ScrollingFrame")
    dropdownList.Size = UDim2.new(0.55, 0, 0, 0)
    dropdownList.Position = UDim2.new(0.4, 5, 1, 2)
    dropdownList.BackgroundColor3 = currentTheme.Dropdown
    dropdownList.BorderSizePixel = 1
    dropdownList.BorderColor3 = currentTheme.Border
    dropdownList.ScrollBarThickness = 3
    dropdownList.Visible = false
    dropdownList.ClipsDescendants = true
    dropdownList.Parent = frame
    
    local dropdownCorner2 = Instance.new("UICorner")
    dropdownCorner2.CornerRadius = UDim.new(0, Settings.CornerRadius - 2)
    dropdownCorner2.Parent = dropdownList
    
    local selected = default or options[1]
    local isOpen = false
    
    local function populateDropdown()
        for _, child in pairs(dropdownList:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        local yPos = 0
        for _, option in ipairs(options) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, -4, 0, 32)
            optBtn.Position = UDim2.new(0, 2, 0, yPos)
            optBtn.BackgroundColor3 = currentTheme.Dropdown
            optBtn.BorderSizePixel = 0
            optBtn.Text = option
            optBtn.TextColor3 = currentTheme.Text
            optBtn.TextSize = 14
            optBtn.Font = Enum.Font.Gotham
            optBtn.Parent = dropdownList
            
            optBtn.MouseEnter:Connect(function()
                optBtn.BackgroundColor3 = currentTheme.Accent
            end)
            
            optBtn.MouseLeave:Connect(function()
                optBtn.BackgroundColor3 = currentTheme.Dropdown
            end)
            
            optBtn.MouseButton1Click:Connect(function()
                selected = option
                dropdownBtn.Text = option
                dropdownList.Visible = false
                isOpen = false
                dropdownList.Size = UDim2.new(0.55, 0, 0, 0)
                if callback then callback(option) end
            end)
            
            yPos = yPos + 34
        end
        
        dropdownList.CanvasSize = UDim2.new(0, 0, 0, yPos + 5)
    end
    
    populateDropdown()
    
    dropdownBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        dropdownList.Visible = isOpen
        if isOpen then
            local listHeight = math.min(#options * 34 + 10, 200)
            dropdownList.Size = UDim2.new(0.55, 0, 0, listHeight)
        else
            dropdownList.Size = UDim2.new(0.55, 0, 0, 0)
        end
    end)
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetValue = function(_, value)
            selected = value
            dropdownBtn.Text = value
            if callback then callback(value) end
        end,
        GetValue = function()
            return selected
        end,
        RefreshOptions = function(_, newOptions)
            options = newOptions
            populateDropdown()
        end
    }
end

