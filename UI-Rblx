local function safeCleanup()
    pcall(function()
        if _G[UI_INSTANCE_NAME] then
            local oldUI = _G[UI_INSTANCE_NAME]
            if oldUI.ScreenGui and oldUI.ScreenGui.Parent then
                oldUI.ScreenGui:Destroy()
            end
            if oldUI.IconButton and oldUI.IconButton.Parent then
                oldUI.IconButton:Destroy()
            end
            if oldUI.ParticleSystem then
                oldUI.ParticleSystem:Destroy()
            end
            _G[UI_INSTANCE_NAME] = nil
        end
    end)
end

