    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.7, 0, 0.4, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = UI_THEME.Text
    labelText.TextSize = 14
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local valueText = Instance.new("TextLabel")
    valueText.Size = UDim2.new(0.3, 0, 0.4, 0)
    valueText.Position = UDim2.new(0.7, 0, 0, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = tostring(default)
    valueText.TextColor3 = UI_THEME.Accent
    valueText.TextSize = 14
    valueText.TextXAlignment = Enum.TextXAlignment.Right
    valueText.Font = Enum.Font.Gotham
    valueText.Parent = frame
    
    local sliderBar = Instance.new("Frame")
    sliderBar.Size = UDim2.new(1, 0, 0, 4)
    sliderBar.Position = UDim2.new(0, 0, 0.7, 0)
    sliderBar.BackgroundColor3 = UI_THEME.SliderBg
    sliderBar.BorderSizePixel = 0
    sliderBar.Parent = frame
    
    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim.new(1, 0)
    sliderCorner.Parent = sliderBar
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = UI_THEME.SliderFill
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBar
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = sliderFill
    
    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(0, 16, 0, 16)
    sliderBtn.Position = UDim2.new((default - min) / (max - min), -8, 0.7, -6)
    sliderBtn.BackgroundColor3 = UI_THEME.Accent
    sliderBtn.BorderSizePixel = 0
    sliderBtn.Text = ""
    sliderBtn.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = sliderBtn
    
    local value = default or min
    local dragging = false
    
    local function updateSlider(input)
        local relativeX = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * relativeX
        value = math.round(value)
        sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        sliderBtn.Position = UDim2.new(relativeX, -8, 0.7, -6)
        valueText.Text = tostring(value)
        if callback then callback(value) end
    end
    
    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    sliderBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetValue = function(_, newValue)
            value = math.clamp(newValue, min, max)
            local relativeX = (value - min) / (max - min)
            sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
            sliderBtn.Position = UDim2.new(relativeX, -8, 0.7, -6)
            valueText.Text = tostring(value)
            if callback then callback(value) end
        end,
        GetValue = function()
            return value
        end
    }
end

-- Add Dropdown (FIXED)
function UILibrary:AddDropdown(tabData, label, options, default, callback)
    if not options or #options == 0 then
        error("Dropdown must have at least one option")
        return
    end
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.Position = UDim2.new(0, 5, 0, #tabData.Elements * 45 + 5)
    frame.BackgroundTransparency = 1
    frame.Parent = tabData.Content
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.4, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = UI_THEME.Text
    labelText.TextSize = 14
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Font = Enum.Font.Gotham
    labelText.Parent = frame
    
    local dropdownBtn = Instance.new("TextButton")
    dropdownBtn.Size = UDim2.new(0.5, 0, 1, 0)
    dropdownBtn.Position = UDim2.new(0.5, 0, 0, 0)
    dropdownBtn.BackgroundColor3 = UI_THEME.Dropdown
    dropdownBtn.BorderSizePixel = 1
    dropdownBtn.BorderColor3 = UI_THEME.Border
    dropdownBtn.Text = default or options[1]
    dropdownBtn.TextColor3 = UI_THEME.Text
    dropdownBtn.TextSize = 13
    dropdownBtn.Font = Enum.Font.Gotham
    dropdownBtn.Parent = frame
    
    local dropdownCorner = Instance.new("UICorner")
    dropdownCorner.CornerRadius = UDim.new(0, 4)
    dropdownCorner.Parent = dropdownBtn
    
    local dropdownList = Instance.new("ScrollingFrame")
    dropdownList.Size = UDim2.new(0.5, 0, 0, 0)
    dropdownList.Position = UDim2.new(0.5, 0, 1, 2)
    dropdownList.BackgroundColor3 = UI_THEME.Dropdown
    dropdownList.BorderSizePixel = 1
    dropdownList.BorderColor3 = UI_THEME.Border
    dropdownList.ScrollBarThickness = 3
    dropdownList.Visible = false
    dropdownList.ClipsDescendants = true
    dropdownList.Parent = frame
    
    local dropdownCorner2 = Instance.new("UICorner")
    dropdownCorner2.CornerRadius = UDim.new(0, 4)
    dropdownCorner2.Parent = dropdownList
    
    local selected = default or options[1]
    local isOpen = false
    
    -- Populate dropdown
    local function populateDropdown()
        -- Clear existing options
        for _, child in pairs(dropdownList:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        local yPos = 0
        for _, option in ipairs(options) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, -4, 0, 30)
            optBtn.Position = UDim2.new(0, 2, 0, yPos)
            optBtn.BackgroundColor3 = UI_THEME.Dropdown
            optBtn.BorderSizePixel = 0
            optBtn.Text = option
            optBtn.TextColor3 = UI_THEME.Text
            optBtn.TextSize = 13
            optBtn.Font = Enum.Font.Gotham
            optBtn.Parent = dropdownList
            
            optBtn.MouseEnter:Connect(function()
                optBtn.BackgroundColor3 = UI_THEME.Accent
            end)
            
            optBtn.MouseLeave:Connect(function()
                optBtn.BackgroundColor3 = UI_THEME.Dropdown
            end)
            
            optBtn.MouseButton1Click:Connect(function()
                selected = option
                dropdownBtn.Text = option
                dropdownList.Visible = false
                isOpen = false
                dropdownList.Size = UDim2.new(0.5, 0, 0, 0)
                if callback then callback(option) end
            end)
            
            yPos = yPos + 32
        end
        
        dropdownList.CanvasSize = UDim2.new(0, 0, 0, yPos + 5)
    end
    
    populateDropdown()
    
    dropdownBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        dropdownList.Visible = isOpen
        if isOpen then
            local listHeight = math.min(#options * 32 + 10, 200)
            dropdownList.Size = UDim2.new(0.5, 0, 0, listHeight)
        else
            dropdownList.Size = UDim2.new(0.5, 0, 0, 0)
        end
    end)
    
    table.insert(tabData.Elements, frame)
    
    return {
        SetValue = function(_, value)
            selected = value
            dropdownBtn.Text = value
            if callback then callback(value) end
        end,
        GetValue = function()
            return selected
        end,
        RefreshOptions = function(_, newOptions)
            options = newOptions
            populateDropdown()
        end
    }
end

