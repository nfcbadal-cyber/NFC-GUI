function UILibrary:ApplyTheme(themeName)
    local theme = UI_THEMES[themeName]
    if not theme then return end
    
    Settings.Theme = themeName
    self.CurrentTheme = themeName
    
    -- Apply theme to all elements
    local elements = {
        {self.Window, "BackgroundColor3", theme.Background},
        {self.Window, "BorderColor3", theme.Border},
        {self.TopBar, "BackgroundColor3", theme.TopBar},
        {self.ContentArea, "BackgroundColor3", theme.Background},
        {self.ContentArea, "BorderColor3", theme.Border},
        {self.IconButton, "BackgroundColor3", theme.IconBg},
        {self.IconButton, "BorderColor3", theme.Accent},
        {self.IconGlow, "ImageColor3", theme.Accent},
        {self.IconGlowRing, "BorderColor3", theme.Accent},
        {self.MiniUI, "BackgroundColor3", theme.TopBar},
        {self.MiniUI, "BorderColor3", theme.Border},
        {self.Title, "TextColor3", theme.Text},
        {self.MinimizeBtn, "TextColor3", theme.Text},
        {self.MaximizeBtn, "TextColor3", theme.Text},
        {self.MiniMinBtn, "TextColor3", theme.Text},
        {self.MiniMaxBtn, "TextColor3", theme.Text},
        {self.ThemeBtn, "TextColor3", theme.Text},
    }
    
    for _, element in ipairs(elements) do
        pcall(function()
            element[1][element[2]] = element[3]
        end)
    end
    
    -- Update particle colors
    for _, p in ipairs(self.Particles) do
        p.Object.BackgroundColor3 = theme.Accent
    end
    
    -- Update title text color
    if self.Title then        self.Title.TextColor3 = theme.Text
    end
    
    -- Update top glow
    if self.TopBar and self.TopBar:FindFirstChild("TopGlow") then
        self.TopBar.TopGlow.BackgroundColor3 = theme.Accent
    end
    
    -- Update gradients
    if self.BGSystem then
        for _, layer in ipairs(self.BGSystem.Layers) do
            layer.Gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, theme.Gradient1),
                ColorSequenceKeypoint.new(0.5, theme.Gradient2),
                ColorSequenceKeypoint.new(1, theme.Gradient3),
            })
        end
    end
end

-- ===== ICON BUTTON =====
function UILibrary:SetupIconButton(iconBtn, window)
    local isVisible = true
    local hoverTween = nil
    
    iconBtn.MouseEnter:Connect(function()
        if hoverTween then hoverTween:Cancel() end
        hoverTween = TweenService:Create(iconBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 75, 0, 75),
            Position = UDim2.new(0, 10, 0.5, -37.5)
        })
        hoverTween:Play()
        
        -- Show glow
        self.IconGlow.Visible = true
        self.IconGlowRing.Visible = true
        TweenService:Create(self.IconGlow, TweenInfo.new(0.3), {
            ImageTransparency = 0.5
        }):Play()
        TweenService:Create(self.IconGlowRing, TweenInfo.new(0.3), {
            BorderTransparency = 0.5
        }):Play()
    end)
    
    iconBtn.MouseLeave:Connect(function()
        if hoverTween then hoverTween:Cancel() end
        hoverTween = TweenService:Create(iconBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 65, 0, 65),
            Position = UDim2.new(0, 15, 0.5, -32.5)
        })
        hoverTween:Play()
        
        TweenService:Create(self.IconGlow, TweenInfo.new(0.3), {
            ImageTransparency = 0.8
        }):Play()
        TweenService:Create(self.IconGlowRing, TweenInfo.new(0.3), {
            BorderTransparency = 0.8
        }):Play()
        wait(0.3)
        self.IconGlow.Visible = false
        self.IconGlowRing.Visible = false
    end)
    
    iconBtn.MouseButton1Click:Connect(function()
        if self.Minimized then
            self:Maximize()
            return
        end
        
        isVisible = not isVisible
        self.IsVisible = isVisible
        
        if isVisible then
            window.Visible = true
            TweenService:Create(window, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -300, 0.5, -250)
            }):Play()
            iconBtn.BackgroundColor3 = UI_THEMES[Settings.Theme].Accent
        else
            TweenService:Create(window, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, -300, 0.5, -300)
            }):Play()
            wait(0.3)
            window.Visible = false
            iconBtn.BackgroundColor3 = UI_THEMES[Settings.Theme].IconBg
        end
    end)
    
    iconBtn.MouseButton2Click:Connect(function()
        if self.Minimized then
            self:Maximize()
        else
            self:Minimize()
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.M and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            if self.Minimized then
                self:Maximize()
            else
                self:Minimize()
            end
        end
    end)
end

