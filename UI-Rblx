-- ===== PARTICLE SYSTEM =====
local function createParticleSystem(parent, color1, color2)
    local particles = Instance.new("Frame")
    particles.Name = "ParticleSystem"
    particles.Size = UDim2.new(1, 0, 1, 0)
    particles.BackgroundTransparency = 1
    particles.Parent = parent
    
    local particleList = {}
    
    for i = 1, Settings.ParticleCount do
        local particle = Instance.new("Frame")
        particle.Size = UDim2.new(0, math.random(2, 6), 0, math.random(2, 6))
        particle.Position = UDim2.new(math.random(), 0, math.random(), 0)
        particle.BackgroundColor3 = color1 or UI_THEMES[Settings.Theme].Accent
        particle.BackgroundTransparency = math.random(50, 80) / 100
        particle.BorderSizePixel = 0
        particle.Parent = particles
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = particle
        
        local speed = math.random(2, 8) / 10
        local direction = math.random(1, 4)
        local offsetX = math.random(-100, 100) / 100
        local offsetY = math.random(-100, 100) / 100
        
        table.insert(particleList, {
            Object = particle,
            Speed = speed,
            Direction = direction,
            OffsetX = offsetX,
            OffsetY = offsetY,
            Color = color1 or UI_THEMES[Settings.Theme].Accent
        })
    end
    
    -- Animate particles
    local connection
    connection = RunService.Heartbeat:Connect(function(delta)
        if not particles.Parent then
            connection:Disconnect()
            return
        end
        
        for _, p in ipairs(particleList) do
            local pos = p.Object.Position
            local xOffset = pos.X.Offset + p.OffsetX * delta * 50 * Settings.AnimationSpeed
            local yOffset = pos.Y.Offset + p.OffsetY * delta * 50 * Settings.AnimationSpeed
            
            if xOffset > 100 or xOffset < -100 then
                p.OffsetX = -p.OffsetX
            end
            if yOffset > 100 or yOffset < -100 then
                p.OffsetY = -p.OffsetY
            end
            
            p.Object.Position = UDim2.new(
                math.clamp(pos.X.Scale + p.OffsetX * delta * 0.1 * Settings.AnimationSpeed, 0, 1),
                math.clamp(xOffset, -100, 100),
                math.clamp(pos.Y.Scale + p.OffsetY * delta * 0.1 * Settings.AnimationSpeed, 0, 1),
                math.clamp(yOffset, -100, 100)
            )
            
            -- Color cycling
            if Settings.RainbowSpeed > 0 then
                local hue = (tick() * 0.1 * Settings.RainbowSpeed + i * 0.01) % 1
                p.Object.BackgroundColor3 = Color3.fromHSV(hue, 0.8, 0.8)
            end
        end
    end)
    
    return {
        Particles = particleList,
        Connection = connection,
        Object = particles
    }
end

-- ===== ANIMATED GRADIENT BACKGROUND =====
local function createAnimatedBackground(parent, theme)
    local bg = Instance.new("Frame")
    bg.Name = "AnimatedBackground"
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundTransparency = 1
    bg.Parent = parent
    
    -- Create multiple layers for animation
    local layers = {}
    for i = 1, 5 do
        local layer = Instance.new("Frame")
        layer.Size = UDim2.new(1, 0, 1, 0)
        layer.BackgroundTransparency = 1
        layer.Parent = bg
        
        local gradient = Instance.new("UIGradient")
        gradient.Rotation = 45 * i
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Gradient1 or UI_THEMES[Settings.Theme].Gradient1),
            ColorSequenceKeypoint.new(0.5, theme.Gradient2 or UI_THEMES[Settings.Theme].Gradient2),
            ColorSequenceKeypoint.new(1, theme.Gradient3 or UI_THEMES[Settings.Theme].Gradient3),
        })
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.7 + i * 0.05),
            NumberSequenceKeypoint.new(0.5, 0.5 + i * 0.05),
            NumberSequenceKeypoint.new(1, 0.7 + i * 0.05),
        })
        gradient.Parent = layer
        
        table.insert(layers, {
            Object = layer,
            Gradient = gradient,
            Rotation = 45 * i,
            Speed = 0.5 + i * 0.2
        })
    end
    
    -- Animate layers
    local connection
    connection = RunService.Heartbeat:Connect(function(delta)
        if not bg.Parent then
            connection:Disconnect()
            return
        end
        
        for _, layer in ipairs(layers) do
            layer.Rotation = (layer.Rotation + delta * 10 * Settings.AnimationSpeed) % 360
            layer.Gradient.Rotation = layer.Rotation
        end
    end)
    
    return {
        Layers = layers,
        Connection = connection,
        Object = bg
    }
end

