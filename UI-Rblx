    end)
    
    self.MiniMaxBtn.MouseButton1Click:Connect(function()
        self:Maximize()
    end)
end

function UILibrary:Minimize()
    if self.Minimized then return end
    self.Minimized = true
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(self.Content, tweenInfo, {
        Size = UDim2.new(1, 0, 0, 0)
    }):Play()
    
    TweenService:Create(self.Window, tweenInfo, {
        Size = UDim2.new(0, 250, 0, 40)
    }):Play()
    
    self.MiniUI.Visible = true
    self.MinimizeBtn.Text = "☐"
    self.MiniMinBtn.Text = "☐"
end

function UILibrary:Maximize()
    if not self.Minimized then return end
    self.Minimized = false
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(self.Content, tweenInfo, {
        Size = UDim2.new(1, 0, 1, -40)
    }):Play()
    
    TweenService:Create(self.Window, tweenInfo, {
        Size = UDim2.new(0, 600, 0, 500)
    }):Play()
    
    self.MiniUI.Visible = false
    self.MinimizeBtn.Text = "─"
    self.MiniMinBtn.Text = "─"
end

