function UILibrary:CreateTab(tabName, icon)
    if not self.TabsContainer then
        error("UI Library not initialized! Call CreateWindow first.")
        return
    end
    
    local tabData = {
        Name = tabName,
        Icon = icon or "📄",
        Elements = {}
    }
    
    local currentTheme = UI_THEMES[Settings.Theme]
    
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_" .. tabName
    tabBtn.Size = UDim2.new(1, -10, 0, 40)
    tabBtn.Position = UDim2.new(0, 5, 0, #self.Tabs * 45 + 5)
    tabBtn.BackgroundColor3 = currentTheme.Background
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = "  " .. tabData.Icon .. " " .. tabName
    tabBtn.TextColor3 = currentTheme.TextDim
    tabBtn.TextSize = 14
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Font = Enum.Font.GothamMedium
    tabBtn.Parent = self.TabsContainer
    
    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, Settings.CornerRadius - 2)
    tabCorner.Parent = tabBtn
    
    -- Tab hover effect
    tabBtn.MouseEnter:Connect(function()
        if tabBtn ~= self.CurrentTab and self.CurrentTab then
            tabBtn.BackgroundColor3 = currentTheme.TopBar
        end
    end)
    
    tabBtn.MouseLeave:Connect(function()
        if tabBtn ~= self.CurrentTab and self.CurrentTab then
            tabBtn.BackgroundColor3 = currentTheme.Background
        end
    end)
    
    self.TabsContainer.CanvasSize = UDim2.new(0, 0, 0, (#self.Tabs + 1) * 45 + 10)
    
    local tabContent = Instance.new("Frame")
    tabContent.Name = "TabContent_" .. tabName
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = self.ContentArea
    
    tabData.Button = tabBtn
    tabData.Content = tabContent
    
    table.insert(self.Tabs, tabData)
    
    tabBtn.MouseButton1Click:Connect(function()
        self:SelectTab(tabData)
    end)
    
    if #self.Tabs == 1 then
        self:SelectTab(tabData)
    end
    
    return {
        Tab = tabData,
        AddToggle = function(_, label, default, callback)
            return UILibrary:AddToggle(tabData, label, default, callback)
        end,
        AddSlider = function(_, label, min, max, default, callback)
            return UILibrary:AddSlider(tabData, label, min, max, default, callback)
        end,
        AddDropdown = function(_, label, options, default, callback)
            return UILibrary:AddDropdown(tabData, label, options, default, callback)
        end,
        AddTextBox = function(_, label, default, callback)
            return UILibrary:AddTextBox(tabData, label, default, callback)
        end,
        AddColorPicker = function(_, label, default, callback)
            return UILibrary:AddColorPicker(tabData, label, default, callback)
        end,
        AddButton = function(_, label, callback)
            return UILibrary:AddButton(tabData, label, callback)
        end,
        AddLabel = function(_, label, text)
            return UILibrary:AddLabel(tabData, label, text)
        end
    }
end

-- ===== SELECT TAB =====
function UILibrary:SelectTab(tabData)
    local currentTheme = UI_THEMES[Settings.Theme]
    
    if self.CurrentTab then
        self.CurrentTab.Content.Visible = false
        self.CurrentTab.Button.BackgroundColor3 = currentTheme.Background
        self.CurrentTab.Button.TextColor3 = currentTheme.TextDim
    end
    
    self.CurrentTab = tabData
    tabData.Content.Visible = true
    tabData.Button.BackgroundColor3 = currentTheme.Accent
    tabData.Button.TextColor3 = currentTheme.Text
end

